<Window x:Class="CarreraApp.UI.LeaderboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pizarra de Clasificación Oficial" Height="760" Width="1200"
        Background="#0B0B0E" FontFamily="Segoe UI" WindowState="Maximized">

    <Grid Margin="25,20,25,20">
        <Grid.RowDefinitions>
            <!-- Cabecera con Logos y Títulos -->
            <RowDefinition Height="Auto"/>
            <!-- Podio: 1°, 2° y 3° Lugar -->
            <RowDefinition Height="Auto"/>
            <!-- Posiciones 4° en adelante en Grilla de 4 Columnas -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA DE LA PIZARRA CON LOGOS -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <!-- Logo Izquierdo -->
            <Image Name="ImgLogoIzquierdo" Grid.Column="0" MaxHeight="80" MaxWidth="140" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <!-- Título de la Carrera y Subtítulo de Categoría -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Name="TxtNombreCarrera" Text="NOMBRE DE LA CARRERA" FontSize="32" FontWeight="Black" Foreground="White" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Name="TxtNombreCategoria" Text="Resultados: Categoría" FontSize="20" FontWeight="Bold" Foreground="#F4D03F" TextAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Logo Derecho -->
            <Image Name="ImgLogoDerecho" Grid.Column="2" MaxHeight="80" MaxWidth="140" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- PODIO: POSICIONES 1°, 2° Y 3° -->
        <ItemsControl Grid.Row="1" Name="ListaPodio" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Height="{Binding AlturaPodio}" Background="{Binding ColorFondoPodio}" 
                            BorderBrush="{Binding ColorBordePodio}" BorderThickness="2" CornerRadius="8" Margin="0,0,0,8" Padding="20,0">
                        <DockPanel VerticalAlignment="Center">
                            <!-- Posición (ej: 1°, 2°, 3°) -->
                            <TextBlock Text="{Binding IconoPuesto}" FontSize="{Binding FontSizePuestoPodio}" 
                                       FontWeight="Black" Foreground="{Binding ColorTextoPodio}" Width="55" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                            <!-- Tiempo Neto -->
                            <TextBlock Text="{Binding TiempoFormateado}" FontSize="{Binding FontSizeTiempoPodio}" 
                                       FontWeight="Bold" FontFamily="Consolas" Foreground="{Binding ColorTextoPodio}" DockPanel.Dock="Right" VerticalAlignment="Center"/>

                            <!-- Nombre del Corredor -->
                            <TextBlock Text="{Binding Nombre}" FontSize="{Binding FontSizeNombrePodio}" 
                                       FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="10,0,15,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- POSICIONES 4° EN ADELANTE: GRILLA COMPACTA DE 4 COLUMNAS PARA TV -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="ListaResto">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#131317" BorderBrush="#222228" BorderThickness="1" CornerRadius="4" Margin="3,2" Padding="8,5">
                            <DockPanel LastChildFill="True">
                                <!-- Puesto pequeño (ej. 4°) -->
                                <TextBlock Text="{Binding IconoPuesto}" FontSize="12" FontWeight="Bold" Foreground="#888888" Width="30" DockPanel.Dock="Left" VerticalAlignment="Center"/>

                                <!-- Tiempo Neto -->
                                <TextBlock Text="{Binding TiempoFormateado}" FontSize="12" FontFamily="Consolas" Foreground="#888888" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="5,0,0,0"/>

                                <!-- Nombre del Corredor -->
                                <TextBlock Text="{Binding Nombre}" FontSize="13" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>