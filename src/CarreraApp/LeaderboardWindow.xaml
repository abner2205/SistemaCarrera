<Window x:Class="CarreraApp.UI.LeaderboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pizarra de Clasificación Oficial"
        Height="760" Width="1200" MinHeight="480" MinWidth="720"
        Background="{DynamicResource LeaderboardBgBrush}"
        Foreground="{DynamicResource LeaderboardTextBrush}"
        FontFamily="Segoe UI"
        WindowState="Maximized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <!-- Cabecera con Logos y Títulos -->
            <RowDefinition Height="Auto"/>
            <!-- Podio: 1°, 2° y 3° Lugar -->
            <RowDefinition Height="Auto"/>
            <!-- Posiciones 4° en adelante en Grilla de 4 Columnas -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA DE LA PIZARRA CON LOGOS -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <!-- Logo Izquierdo -->
            <Image Name="ImgLogoIzquierdo" Grid.Column="0" MaxHeight="80" MaxWidth="140" Stretch="Uniform"
                   HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <!-- Título de la Carrera y Subtítulo de Categoría -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="48" HorizontalAlignment="Center">
                    <TextBlock Name="TxtNombreCarrera"
                               Text="Pizarra de clasificación"
                               FontSize="32" FontWeight="Bold"
                               Foreground="#F8FAFC"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Viewbox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock Name="TxtNombreCategoria"
                               Text="Resultados: Categoría"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="#FACC15"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Name="TxtUltimaActualizacion"
                               Text=""
                               FontSize="13"
                               FontFamily="Consolas, Cascadia Mono, Courier New"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="#CBD5E1"
                               VerticalAlignment="Center"
                               Margin="16,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Logo Derecho -->
            <Image Name="ImgLogoDerecho" Grid.Column="2" MaxHeight="80" MaxWidth="140" Stretch="Uniform"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- ESTADO VACÍO CUANDO NO HAY TIEMPOS O NO HAY CARRERA ACTIVA -->
        <Border Name="PanelEstadoVacio"
                Grid.Row="1" Grid.RowSpan="2"
                Background="#111827"
                BorderBrush="#334155"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="36,28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="640"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Name="TxtEstadoVacioTitulo"
                           Text="Aún no hay tiempos registrados"
                           FontSize="24" FontWeight="Bold"
                           Foreground="#F8FAFC"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock Name="TxtEstadoVacioDetalle"
                           Text="Los resultados oficiales aparecerán aquí automáticamente en cuanto los corredores crucen la meta."
                           FontSize="15"
                           Foreground="#CBD5E1"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- PODIO: POSICIONES 1°, 2° Y 3° -->
        <ItemsControl Grid.Row="1" Name="ListaPodio" Margin="0,0,0,14">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Height="{Binding AlturaPodio}"
                            Background="{Binding ColorFondoPodio}"
                            BorderBrush="{Binding ColorBordePodio}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Margin="0,0,0,8"
                            Padding="20,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Posición (1°, 2°, 3°) -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding IconoPuesto}"
                                       FontSize="{Binding FontSizePuestoPodio}"
                                       FontWeight="Bold"
                                       FontFamily="Consolas, Cascadia Mono, Courier New"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{Binding ColorTextoPodio}"
                                       VerticalAlignment="Center"/>

                            <!-- Dorsal tabular -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DorsalFormateado}"
                                       FontSize="{Binding FontSizeTiempoPodio}"
                                       FontWeight="SemiBold"
                                       FontFamily="Consolas, Cascadia Mono, Courier New"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="#CBD5E1"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <!-- Nombre del Corredor (truncado seguro sin desplazar posición, dorsal ni tiempo) -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Nombre}"
                                       ToolTip="{Binding Nombre}"
                                       FontSize="{Binding FontSizeNombrePodio}"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"
                                       VerticalAlignment="Center"
                                       Margin="4,0,16,0"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Tiempo Neto tabular -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding TiempoFormateado}"
                                       FontSize="{Binding FontSizeTiempoPodio}"
                                       FontWeight="Bold"
                                       FontFamily="Consolas, Cascadia Mono, Courier New"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{Binding ColorTextoPodio}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- POSICIONES 4° EN ADELANTE: GRILLA COMPACTA DE 4 COLUMNAS PARA TV -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="ListaResto">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#111827"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="4,3"
                                Padding="10,6">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Puesto tabular (ej. 4°) -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding IconoPuesto}"
                                           FontSize="13" FontWeight="Bold"
                                           FontFamily="Consolas, Cascadia Mono, Courier New"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="#CBD5E1"
                                           VerticalAlignment="Center"/>

                                <!-- Dorsal tabular -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DorsalFormateado}"
                                           FontSize="12"
                                           FontFamily="Consolas, Cascadia Mono, Courier New"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>

                                <!-- Nombre del Corredor (truncado seguro) -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Nombre}"
                                           ToolTip="{Binding Nombre}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#F8FAFC"
                                           VerticalAlignment="Center"
                                           Margin="2,0,8,0"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Tiempo Neto tabular -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding TiempoFormateado}"
                                           FontSize="12"
                                           FontFamily="Consolas, Cascadia Mono, Courier New"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="#E2E8F0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
