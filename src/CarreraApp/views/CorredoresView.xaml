<UserControl x:Class="CarreraApp.UI.Views.CorredoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            
            <!-- Formulario Inscribir Corredor -->
            <Border Background="White" CornerRadius="8" Padding="20">
                <Border.Effect><DropShadowEffect BlurRadius="5" Color="#D1D5DB" ShadowDepth="1" Opacity="0.5"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Inscribir / Editar Corredor" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Dorsal:" FontWeight="SemiBold"/>
                    <TextBox Name="InputDorsal" Padding="8" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Nombre:" FontWeight="SemiBold"/>
                    <TextBox Name="InputNombre" Padding="8" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Categoría:" FontWeight="SemiBold"/>
                    <ComboBox Name="ComboCategoria" DisplayMemberPath="Nombre" SelectedValuePath="ID_Categoria" Margin="0,0,0,10" Padding="5"/>
                    
                    <TextBlock Text="Hit de Salida:" FontWeight="SemiBold"/>
                    <ComboBox Name="ComboHit" DisplayMemberPath="Nombre_Hit" SelectedValuePath="ID_Hit" Margin="0,0,0,15" Padding="5"/>

                    <Button Name="BtnAccionCorredor" Content="REGISTRAR CORREDOR" Click="BtnGuardarCorredor_Click" Background="#28A745" Foreground="White" FontWeight="Bold" Padding="10" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Lista de Corredores con Tiempos y Botón de Exportar a Excel -->
        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
            <Border.Effect><DropShadowEffect BlurRadius="5" Color="#D1D5DB" ShadowDepth="1" Opacity="0.5"/></Border.Effect>
            <DockPanel>
                <!-- Barra Superior: Título y Botón Exportar a Excel -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                    <TextBlock Text="Corredores Inscritos" FontSize="20" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Button Name="BtnExportarExcel" Content="📊 EXPORTAR A EXCEL" Click="BtnExportarExcel_Click" 
                            Background="#217346" Foreground="White" FontWeight="Bold" Padding="15,8" BorderThickness="0" 
                            DockPanel.Dock="Right" HorizontalAlignment="Right" Cursor="Hand"/>
                </DockPanel>

                <DataGrid Name="TablaCorredores" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Dorsal" Binding="{Binding Dorsal}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="140"/>
                        <DataGridTextColumn Header="Hit" Binding="{Binding NombreHit}" Width="120"/>

                        <!-- Nueva Columna: Tiempo Neto Registrado -->
                        <DataGridTextColumn Header="Tiempo Neto" Binding="{Binding TiempoFormateado}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#0078D7"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80"/>

                        <!-- Columna de Acciones -->
                        <DataGridTemplateColumn Header="Acciones" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Ed" Click="BtnEditarCorredor_Click" Background="#FFC107" FontWeight="Bold" BorderThickness="0" Margin="0,0,5,0" Padding="6,2" Cursor="Hand"/>
                                        <Button Content="X" Click="BtnEliminarCorredor_Click" Background="#DC3545" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="6,2" Cursor="Hand"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>