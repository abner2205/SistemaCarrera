<UserControl x:Class="CarreraApp.UI.Views.CorredoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CarreraApp.UI.Views"
             Background="{DynamicResource ChalkSurfaceBrush}"
             FontFamily="{DynamicResource UiFontFamily}">
    <UserControl.Resources>
        <local:EstadoCorredorDescripcionConverter x:Key="EstadoCorredorDescripcionConverter"/>
        <local:EstadoCorredorTooltipConverter x:Key="EstadoCorredorTooltipConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Banner de feedback en línea (respaldo cuando la vista se usa sin MainWindow) -->
        <Border x:Name="BannerFeedbackCorredores"
                Grid.Row="0"
                Visibility="Collapsed"
                CornerRadius="6"
                BorderThickness="1.5"
                Padding="14,10"
                Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <Button x:Name="BtnCerrarBannerCorredores"
                        DockPanel.Dock="Right"
                        Content="✕"
                        Click="BtnCerrarBannerCorredores_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        MinHeight="24"
                        Padding="8,2"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        ToolTip="Cerrar aviso"/>
                <TextBlock x:Name="TxtBannerFeedbackCorredores"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Columna Izquierda: Formulario Inscribir / Editar Corredor -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                <Border Background="{DynamicResource PureWhiteBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="TxtTituloFormularioCorredor"
                                   Text="Inscribir corredor"
                                   Style="{DynamicResource SectionTitleTextStyle}"
                                   FontSize="18"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="Dorsal" Style="{DynamicResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="InputDorsal"
                                 Style="{DynamicResource TabularTextBoxStyle}"
                                 TextChanged="InputDorsal_TextChanged"
                                 Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtErrorDorsal"
                                   Style="{DynamicResource InlineErrorTextStyle}"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Nombre completo" Style="{DynamicResource FieldLabelTextStyle}" Margin="0,6,0,4"/>
                        <TextBox x:Name="InputNombre"
                                 TextChanged="InputNombre_TextChanged"
                                 Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtErrorNombreCorredor"
                                   Style="{DynamicResource InlineErrorTextStyle}"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Categoría" Style="{DynamicResource FieldLabelTextStyle}" Margin="0,6,0,4"/>
                        <ComboBox x:Name="ComboCategoria"
                                  DisplayMemberPath="Nombre"
                                  SelectedValuePath="ID_Categoria"
                                  SelectionChanged="ComboCategoria_SelectionChanged"
                                  Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtErrorCategoria"
                                   Style="{DynamicResource InlineErrorTextStyle}"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Hit de salida" Style="{DynamicResource FieldLabelTextStyle}" Margin="0,6,0,4"/>
                        <ComboBox x:Name="ComboHit"
                                  DisplayMemberPath="Nombre_Hit"
                                  SelectedValuePath="ID_Hit"
                                  SelectionChanged="ComboHit_SelectionChanged"
                                  Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtErrorHit"
                                   Style="{DynamicResource InlineErrorTextStyle}"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Estado de participación" Style="{DynamicResource FieldLabelTextStyle}" Margin="0,6,0,4"/>
                        <ComboBox x:Name="ComboEstado"
                                  Margin="0,0,0,6">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EstadoCorredorDescripcionConverter}}"
                                               ToolTip="{Binding Converter={StaticResource EstadoCorredorTooltipConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Activo: en competencia · DNS: No salió · DNF: No finalizó"
                                   Style="{DynamicResource MutedLabelTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <Border x:Name="TxtAvisoBloqueoTiempo"
                                Background="{DynamicResource CautionAmberSurfaceBrush}"
                                BorderBrush="{DynamicResource CautionAmberBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <TextBlock Text="Este corredor ya registró tiempo: no es posible cambiar su Hit ni pasar su estado a DNS o DNF."
                                       Foreground="{DynamicResource CautionAmberDarkTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <ProgressBar x:Name="ProgresoGuardadoCorredor"
                                     IsIndeterminate="True"
                                     Height="4"
                                     Foreground="{DynamicResource FinishEmeraldBrush}"
                                     Visibility="Collapsed"
                                     Margin="0,0,0,8"/>

                        <Button x:Name="BtnAccionCorredor"
                                Content="Registrar corredor"
                                Style="{DynamicResource SuccessButtonStyle}"
                                Click="BtnGuardarCorredor_Click"/>
                        <Button x:Name="BtnCancelarEdicion"
                                Content="Cancelar edición"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="BtnCancelarEdicion_Click"
                                Margin="0,8,0,0"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Columna Derecha: Lista de Corredores con Tiempos y Exportar CSV -->
            <Border Grid.Column="1"
                    Background="{DynamicResource PureWhiteBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <DockPanel>
                    <!-- Barra Superior: Título, contador y Botón Exportar CSV -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Corredores inscritos"
                                       Style="{DynamicResource PageTitleTextStyle}"
                                       FontSize="20"/>
                            <TextBlock x:Name="TxtContadorCorredores"
                                       Text="0 corredores registrados"
                                       Style="{DynamicResource TabularTextStyle}"
                                       Foreground="{DynamicResource SlateMutedBrush}"
                                       FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <ProgressBar x:Name="ProgresoExportacionCorredores"
                                         Width="90"
                                         Height="4"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource FinishEmeraldBrush}"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                            <Button x:Name="BtnExportarExcel"
                                    Content="Exportar CSV (Excel)"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Click="BtnExportarExcel_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <DataGrid x:Name="TablaCorredores"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="{DynamicResource PureWhiteBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}"
                                  BorderThickness="1"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource SurfaceSubtleBrush}"
                                  RowHeaderWidth="0"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dorsal" Binding="{Binding Dorsal}" Width="75">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}"/>
                                            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TrackInkBrush}"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TrackInkBrush}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SlateMutedBrush}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Hit" Binding="{Binding NombreHit}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SlateMutedBrush}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Tiempo neto" Binding="{Binding TiempoFormateado}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}"/>
                                            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SignalCobaltBrush}"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Estado" Width="155">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding EstadosDisponibles}"
                                                      SelectedItem="{Binding Estado, Mode=OneWay}"
                                                      IsEnabled="{Binding PuedeModificarEstadoYHit}"
                                                      SelectionChanged="ComboEstadoFila_SelectionChanged"
                                                      MinHeight="28"
                                                      Padding="6,3"
                                                      Margin="2"
                                                      ToolTip="{Binding TooltipEstado}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EstadoCorredorDescripcionConverter}}"
                                                                   ToolTip="{Binding Converter={StaticResource EstadoCorredorTooltipConverter}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Acciones" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="Editar"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        Click="BtnEditarCorredor_Click"
                                                        MinHeight="28"
                                                        Padding="10,4"
                                                        Margin="0,0,6,0"
                                                        ToolTip="Editar datos del corredor"/>
                                                <Button Content="Eliminar"
                                                        Style="{DynamicResource DangerButtonStyle}"
                                                        Click="BtnEliminarCorredor_Click"
                                                        MinHeight="28"
                                                        Padding="10,4"
                                                        ToolTip="Eliminar corredor de la carrera"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Estado vacío accionable -->
                        <Border x:Name="PanelEstadoVacioCorredores"
                                Background="{DynamicResource ChalkSurfaceBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                                <TextBlock x:Name="TxtEstadoVacioTitulo"
                                           Text="Sin corredores inscritos"
                                           Style="{DynamicResource SectionTitleTextStyle}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtEstadoVacioDescripcion"
                                           Text="Completa el formulario de la izquierda para inscribir al primer corredor."
                                           Style="{DynamicResource MutedLabelTextStyle}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,0,0,16"/>
                                <Button x:Name="BtnAccionEstadoVacio"
                                        Content="Inscribir primer corredor"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Click="BtnAccionEstadoVacio_Click"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
