<UserControl x:Class="CarreraApp.UI.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9" FontFamily="Segoe UI">
    
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Gestor de Eventos" FontSize="36" FontWeight="Black" Foreground="#111827" Margin="0,0,0,30"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Izquierdo: Lista de Carreras -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,20,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="5" Color="#D1D5DB" ShadowDepth="1" Opacity="0.5"/>
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Carreras Existentes" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                    <ListView Name="ListaCarreras" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonDown="CarreraExistente_Click">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nombre}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" Foreground="#666"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- Panel Derecho: Crear Nueva y Acceso QR (Ahora con Scroll) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="0,0,10,0">
                <StackPanel>
                    
                    <!-- 1. Formulario de Creación -->
                    <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" Color="#D1D5DB" ShadowDepth="1" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Crear Nueva Carrera" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                            
                            <TextBlock Text="Nombre del Evento:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Name="InputNombreCarrera" Padding="10" FontSize="16" Margin="0,0,0,15" Background="#F9FAFB"/>

                            <TextBlock Text="Fecha:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker Name="InputFechaCarrera" Padding="5" FontSize="16" Margin="0,0,0,25"/>

                            <Button Content="CREAR Y GESTIONAR" Click="BtnCrearCarrera_Click" Background="#28A745" Foreground="White" FontWeight="Bold" FontSize="16" Padding="15" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Panel del Código QR -->
                    <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" Color="#D1D5DB" ShadowDepth="1" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Acceso para Jueces" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="Escanee con el teléfono para conectar la cámara" FontSize="14" Foreground="#666" HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap" TextAlignment="Center"/>
                            
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="5">
                                <Image Name="QrImage" Width="150" Height="150" Stretch="Uniform"/>
                            </Border>
                            
                            <TextBlock Name="TxtUrlServer" FontSize="14" FontWeight="Bold" Foreground="#0078D7" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>