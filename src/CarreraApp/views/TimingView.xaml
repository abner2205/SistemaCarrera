<UserControl x:Class="CarreraApp.UI.Views.TimingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ChalkSurfaceBrush}"
             FontFamily="{DynamicResource UiFontFamily}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Banner de feedback en línea (respaldo cuando la vista se usa sin MainWindow) -->
        <Border x:Name="BannerFeedbackTiming"
                Grid.Row="0"
                Visibility="Collapsed"
                CornerRadius="6"
                BorderThickness="1.5"
                Padding="14,10"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <Button x:Name="BtnCerrarBannerTiming"
                        DockPanel.Dock="Right"
                        Content="✕"
                        Click="BtnCerrarBannerTiming_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        MinHeight="24"
                        Padding="8,2"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        ToolTip="Cerrar aviso"/>
                <TextBlock x:Name="TxtBannerFeedbackTiming"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Columna Izquierda: Hits -->
                <ColumnDefinition Width="300"/>
                <!-- Columna Central: Bandeja y Visor de Fotos -->
                <ColumnDefinition Width="*"/>
                <!-- Columna Derecha: Cola de Fotos y Monitoreo -->
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: CONTROL DE SALIDAS (HITS) -->
            <Border Grid.Column="0"
                    Background="{DynamicResource PureWhiteBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
                        <TextBlock Text="Control de salidas (Hits)"
                                   Style="{DynamicResource SectionTitleTextStyle}"
                                   FontSize="18"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtContadorHitsTiming"
                                   Text="0 Hits"
                                   Style="{DynamicResource MutedLabelTextStyle}"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid>
                        <ListView Name="ListaHits"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,4,0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="CardHitBorder"
                                            Background="{DynamicResource PureWhiteBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            Padding="12">
                                        <StackPanel>
                                            <!-- Encabezado del Hit con Badge de Estado -->
                                            <DockPanel Margin="0,0,0,6">
                                                <Border x:Name="BadgeHitEstado"
                                                        DockPanel.Dock="Right"
                                                        Background="{DynamicResource SignalCobaltBrush}"
                                                        CornerRadius="4"
                                                        Padding="8,3"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtBadgeHitEstado"
                                                               Text="En espera"
                                                               Foreground="{DynamicResource PureWhiteBrush}"
                                                               FontSize="11"
                                                               FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Nombre_Hit}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TrackInkBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding Nombre_Hit}"/>
                                            </DockPanel>

                                            <!-- Cronómetro Digital Tabular -->
                                            <TextBlock x:Name="TxtCronometroHit"
                                                       Text="{Binding CronometroTexto}"
                                                       Style="{DynamicResource TabularTimerStyle}"
                                                       FontSize="26"
                                                       Foreground="{DynamicResource SlateMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,6,0,4"/>

                                            <!-- Datos de Inicio y Llegadas -->
                                            <TextBlock Text="{Binding InfoInicio}"
                                                       Style="{DynamicResource MutedLabelTextStyle}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding InfoCorredores}"
                                                       Style="{DynamicResource TabularTextStyle}"
                                                       Foreground="{DynamicResource TrackInkBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,10"/>

                                            <!-- Botón de Iniciar Hit -->
                                            <Button x:Name="BtnEstadoHit"
                                                    Content="Iniciar Hit"
                                                    Style="{DynamicResource PrimaryButtonStyle}"
                                                    Click="BtnIniciarHit_Click"
                                                    Tag="{Binding ID_Hit}"
                                                    IsEnabled="{Binding PuedeIniciar}"
                                                    Padding="10,7"/>
                                        </StackPanel>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <!-- Hit En Curso -->
                                        <DataTrigger Binding="{Binding EstaActivo}" Value="True">
                                            <Setter TargetName="CardHitBorder" Property="Background" Value="#ECFDF5"/>
                                            <Setter TargetName="CardHitBorder" Property="BorderBrush" Value="{DynamicResource FinishEmeraldBrush}"/>
                                            <Setter TargetName="CardHitBorder" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="BadgeHitEstado" Property="Background" Value="{DynamicResource FinishEmeraldBrush}"/>
                                            <Setter TargetName="TxtBadgeHitEstado" Property="Text" Value="En curso"/>
                                            <Setter TargetName="TxtCronometroHit" Property="Foreground" Value="{DynamicResource FinishEmeraldBrush}"/>
                                            <Setter TargetName="BtnEstadoHit" Property="Content" Value="En competencia"/>
                                        </DataTrigger>

                                        <!-- Hit Finalizado -->
                                        <DataTrigger Binding="{Binding EstaFinalizado}" Value="True">
                                            <Setter TargetName="CardHitBorder" Property="Background" Value="{DynamicResource ChalkSurfaceBrush}"/>
                                            <Setter TargetName="CardHitBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                                            <Setter TargetName="BadgeHitEstado" Property="Background" Value="{DynamicResource SlateMutedBrush}"/>
                                            <Setter TargetName="TxtBadgeHitEstado" Property="Text" Value="Finalizado"/>
                                            <Setter TargetName="TxtCronometroHit" Property="Foreground" Value="{DynamicResource TrackInkBrush}"/>
                                            <Setter TargetName="BtnEstadoHit" Property="Content" Value="Finalizado"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Estado vacío accionable de Hits -->
                        <Border x:Name="PanelEstadoVacioHits"
                                Visibility="Collapsed"
                                Background="{DynamicResource ChalkSurfaceBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Sin Hits configurados"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TrackInkBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Crea al menos un Hit en Configuración de Hits para iniciar las salidas y cronometrar llegadas."
                                           Style="{DynamicResource MutedLabelTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>
                                <Button x:Name="BtnIrAHitsTiming"
                                        Content="Ir a Hits y Categorías"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Click="BtnIrAHitsTiming_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- PANEL CENTRAL: VISOR DE LLEGADAS Y ASIGNACIÓN -->
            <Border Grid.Column="1"
                    Background="{DynamicResource PureWhiteBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock Text="Visor de llegadas"
                                   Style="{DynamicResource SectionTitleTextStyle}"
                                   FontSize="18"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="BadgeCapturaActiva"
                                Visibility="Collapsed"
                                DockPanel.Dock="Right"
                                Background="{DynamicResource SelectionTintBrush}"
                                BorderBrush="{DynamicResource SignalCobaltBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHoraCapturaActiva"
                                       Style="{DynamicResource TabularMonoTextStyle}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TrackInkBrush}"/>
                        </Border>
                    </DockPanel>

                    <!-- Controles de Pizarra, Categoría y Logos para TV -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource ChalkSurfaceBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Fila 1: Selector de Categoría y Botones de Pizarra -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Categoría TV:"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TrackInkBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox Name="ComboCategoriasPizarra"
                                              Width="180"
                                              FontSize="12"
                                              Padding="8,5"
                                              MinHeight="32"
                                              VerticalAlignment="Center"
                                              DisplayMemberPath="Nombre"
                                              SelectedValuePath="ID_Categoria"
                                              SelectionChanged="ComboCategoriasPizarra_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Name="BtnPizarra"
                                            Content="Abrir pizarra"
                                            Click="BtnPizarra_Click"
                                            Foreground="{DynamicResource PureWhiteBrush}"
                                            BorderThickness="0"
                                            FontSize="12"
                                            MinHeight="32"
                                            Padding="12,6"
                                            Margin="0,0,6,0"/>
                                    <Button Name="BtnPantallaCompleta"
                                            Content="Pantalla completa"
                                            Style="{DynamicResource PrimaryButtonStyle}"
                                            Click="BtnPantallaCompleta_Click"
                                            FontSize="12"
                                            MinHeight="32"
                                            Padding="12,6"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Fila 2: Gestión y reemplazo de Logos para la Pizarra -->
                            <DockPanel Grid.Row="1" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Logos de pizarra:"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SlateMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <Button Name="BtnSubirLogoIzq"
                                            Content="Logo izquierdo"
                                            Click="BtnSubirLogoIzq_Click"
                                            Foreground="{DynamicResource PureWhiteBrush}"
                                            BorderThickness="0"
                                            FontSize="11"
                                            MinHeight="28"
                                            Padding="10,4"
                                            Margin="0,0,4,0"
                                            ToolTip="Subir o reemplazar logo izquierdo"/>
                                    <Button Name="BtnQuitarLogoIzq"
                                            Content="✕"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Click="BtnQuitarLogoIzq_Click"
                                            FontSize="11"
                                            MinHeight="28"
                                            Padding="8,4"
                                            Margin="0,0,12,0"
                                            ToolTip="Quitar logo izquierdo"/>

                                    <Button Name="BtnSubirLogoDer"
                                            Content="Logo derecho"
                                            Click="BtnSubirLogoDer_Click"
                                            Foreground="{DynamicResource PureWhiteBrush}"
                                            BorderThickness="0"
                                            FontSize="11"
                                            MinHeight="28"
                                            Padding="10,4"
                                            Margin="0,0,4,0"
                                            ToolTip="Subir o reemplazar logo derecho"/>
                                    <Button Name="BtnQuitarLogoDer"
                                            Content="✕"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Click="BtnQuitarLogoDer_Click"
                                            FontSize="11"
                                            MinHeight="28"
                                            Padding="8,4"
                                            ToolTip="Quitar logo derecho"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Visor principal de la foto actual -->
                    <Border x:Name="MarcoVisorPrincipal"
                            Grid.Row="2"
                            Background="{DynamicResource ChalkSurfaceBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,0,10">
                        <Grid>
                            <Image Name="VisorFotoPrincipal" Stretch="Uniform" Margin="6"/>

                            <!-- Estado vacío del visor cuando no hay captura seleccionada -->
                            <StackPanel x:Name="PanelVisorVacio"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="24">
                                <TextBlock Text="Sin captura seleccionada"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TrackInkBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Selecciona una fotografía de la cola derecha para verla en detalle y asignar el dorsal."
                                           Style="{DynamicResource MutedLabelTextStyle}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="340"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Panel de Asignación Rápida con validación en línea -->
                    <StackPanel Grid.Row="3">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock Text="Dorsal:"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="{DynamicResource TrackInkBrush}"/>
                            <TextBox Name="InputDorsal"
                                     Style="{DynamicResource TabularTextBoxStyle}"
                                     Width="110"
                                     FontSize="22"
                                     FontWeight="Bold"
                                     TextAlignment="Center"
                                     Padding="6,4"
                                     VerticalAlignment="Center"
                                     TextChanged="InputDorsal_TextChanged"/>
                            <Button Name="BtnAsignar"
                                    Content="Asignar dorsal (Enter)"
                                    Style="{DynamicResource SuccessButtonStyle}"
                                    Click="BtnAsignar_Click"
                                    FontSize="13"
                                    Padding="14,9"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"/>
                            <Button Name="BtnDescartar"
                                    Content="Descartar foto"
                                    Style="{DynamicResource DangerButtonStyle}"
                                    Click="BtnDescartar_Click"
                                    FontSize="13"
                                    Padding="12,9"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtErrorDorsalTiming"
                                   Style="{DynamicResource InlineErrorTextStyle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Visibility="Collapsed"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PANEL DERECHO: COLA DE FOTOS Y MONITOREO -->
            <Border Grid.Column="2"
                    Background="{DynamicResource PureWhiteBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock Text="Cola de fotos pendientes"
                                   Style="{DynamicResource SectionTitleTextStyle}"
                                   FontSize="17"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtContadorFotosPendientes"
                                   Text="0"
                                   Style="{DynamicResource TabularTextStyle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SlateMutedBrush}"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <ListView Name="ListaFotosPendientes"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="4"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                ClipToBounds="True">
                                            <Image Width="72" Height="72" Stretch="UniformToFill" Source="{Binding Miniatura}"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Hora_Llegada, StringFormat={}{0:HH:mm:ss.fff}}"
                                                       Style="{DynamicResource TabularMonoTextStyle}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TrackInkBrush}"
                                                       Margin="0,0,0,4"/>
                                            <Border Background="{DynamicResource CautionAmberSurfaceBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="Esperando dorsal"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource CautionAmberDarkTextBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Estado vacío de cola de fotos -->
                        <Border x:Name="PanelEstadoVacioFotos"
                                Visibility="Collapsed"
                                Background="{DynamicResource ChalkSurfaceBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Sin capturas pendientes"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TrackInkBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Las fotografías enviadas desde la cámara móvil aparecerán aquí automáticamente."
                                           Style="{DynamicResource MutedLabelTextStyle}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="Últimos registros exitosos"
                               Style="{DynamicResource SectionTitleTextStyle}"
                               FontSize="16"
                               Margin="0,14,0,8"/>

                    <Grid Grid.Row="3">
                        <ListBox Name="LogExito"
                                 Background="{DynamicResource ChalkSurfaceBrush}"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                        <Border x:Name="PanelEstadoVacioRegistros"
                                Visibility="Collapsed"
                                Background="{DynamicResource ChalkSurfaceBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                VerticalAlignment="Top">
                            <TextBlock Text="Los dorsales asignados y eventos de hit se mostrarán aquí."
                                       Style="{DynamicResource MutedLabelTextStyle}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
