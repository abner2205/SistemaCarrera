<Window x:Class="CarreraApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CarreraApp - Gestión de Eventos" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#F4F6F9" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilo para los botones del menú lateral -->
        <Style x:Key="BotonMenuLateral" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#374151"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/> <!-- Barra Superior -->
            <RowDefinition Height="*"/>  <!-- Cuerpo de la App -->
        </Grid.RowDefinitions>

        <!-- Barra Superior Oscura -->
        <Border Grid.Row="0" Background="#111827">
            <StackPanel Orientation="Horizontal">
                <!-- Botón de Hamburguesa -->
                <Button Name="BtnHamburguesa" Content="&#x2261;" Width="60" FontSize="28" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnHamburguesa_Click"/>
                <TextBlock Name="TxtNombreCarrera" Text="CARRERA APP" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Cuerpo Principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Menú Lateral -->
                <ColumnDefinition Width="*"/>    <!-- Contenido Dinámico -->
            </Grid.ColumnDefinitions>

            <!-- Menú Lateral -->
            <Border Name="PanelLateral" Grid.Column="0" Width="250" Background="#1F2937" Visibility="Collapsed">
                <StackPanel Margin="0,10,0,0">
                    <Button Content="Inicio" Style="{StaticResource BotonMenuLateral}" Click="NavInicio_Click"/>
                    <Button Content="Panel de Cronometraje" Style="{StaticResource BotonMenuLateral}" Click="NavCronometraje_Click"/>
                    <Button Content="Gestión de Corredores" Style="{StaticResource BotonMenuLateral}" Click="NavCorredores_Click"/>
                    <Button Content="Configuración de Hits" Style="{StaticResource BotonMenuLateral}" Click="NavHits_Click"/>
                </StackPanel>
            </Border>

            <!-- Aquí se inyectarán las diferentes pantallas -->
            <ContentControl Name="ContenedorPrincipal" Grid.Column="1" Margin="0"/>
        </Grid>
    </Grid>
</Window>